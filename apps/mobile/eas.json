{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        // "EXPO_PUBLIC_API_BASE_URL": "http://192.168.100.249:3001"
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.knutsfordsrc.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.knutsfordsrc.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.knutsfordsrc.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
